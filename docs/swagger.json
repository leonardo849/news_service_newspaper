{
    "swagger": "2.0",
    "info": {
        "description": "api for a news service",
        "title": "Backend News service",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost:port",
    "basePath": "/",
    "paths": {
        "/news/create": {
            "post": {
                "security": [
                    {
                        "JWT": []
                    }
                ],
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "news"
                ],
                "summary": "create news",
                "parameters": [
                    {
                        "description": "news data",
                        "name": "news",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/dto.CreateNewsDTO"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/dto.CreatedMessage"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/dto.ErrorDTO"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/dto.ErrorDTO"
                        }
                    },
                    "403": {
                        "description": "Forbidden",
                        "schema": {
                            "$ref": "#/definitions/dto.ErrorDTO"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/dto.ErrorDTO"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "dto.CreateBlockDTO": {
            "type": "object",
            "required": [
                "content",
                "position"
            ],
            "properties": {
                "content": {
                    "type": "string",
                    "maxLength": 1000
                },
                "images": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/dto.CreateImageDTO"
                    }
                },
                "position": {
                    "type": "integer"
                }
            }
        },
        "dto.CreateImageDTO": {
            "type": "object",
            "required": [
                "block_id",
                "url"
            ],
            "properties": {
                "block_id": {
                    "type": "string"
                },
                "url": {
                    "type": "string"
                }
            }
        },
        "dto.CreateNewsDTO": {
            "type": "object",
            "properties": {
                "authors": {
                    "type": "array",
                    "maxItems": 6,
                    "items": {
                        "type": "string"
                    }
                },
                "blocks": {
                    "type": "array",
                    "maxItems": 20,
                    "minItems": 1,
                    "items": {
                        "$ref": "#/definitions/dto.CreateBlockDTO"
                    }
                },
                "subtitle": {
                    "type": "string"
                },
                "title": {
                    "type": "string"
                },
                "topic": {
                    "type": "string"
                }
            }
        },
        "dto.CreatedMessage": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string"
                },
                "message": {
                    "type": "string"
                }
            }
        },
        "dto.ErrorDTO": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string"
                }
            }
        }
    }
}